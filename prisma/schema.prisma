  productId           String
  quantityReceived    Float
  batchNumber         String?
  expiryDate          DateTime?
  condition           String   @default("good") // good|damaged|rejected
  notes               String?
  createdAt           DateTime @default(now())

  @@index([goodsReceiptId])
  @@map("goods_receipt_lines")
}

