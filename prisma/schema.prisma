  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lines           GoodsReceiptLine[]

  @@unique([tenantId, grNumber])
  @@index([tenantId, status, receivedDate])
  @@index([tenantId, purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
