  entityCode      String?  // business code (SO-1403-00001, INV-1403-00001, etc.)
  changes         Json?    // { before: {...}, after: {...} }
  ipAddress       String?
  userAgent       String?
  correlationId   String?  // LAW-61
  sessionId       String?
  metadata        Json?
  createdAt       DateTime @default(now())

  @@index([tenantId, entityType, entityId, createdAt])
  @@index([tenantId, userId, createdAt])
  @@index([tenantId, action, createdAt])
  @@map("audit_logs")
}

