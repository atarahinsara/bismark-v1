// BISMARK ERP — Prisma Schema (Sandbox Reference Implementation)
// This mirrors the Laravel/PostgreSQL schema from design/*.yaml
// In production, Laravel + PostgreSQL is used (ADR-001).
// In sandbox, Next.js + Prisma + SQLite provides a runnable reference.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// INFRASTRUCTURE TABLES (LAW-06 to LAW-10)
// ============================================================

// LAW-06: Idempotency Keys
model IdempotencyKey {
  id              String   @id @default(cuid())
  tenantId        String
  key             String   // the Idempotency-Key header value (UUID)
  endpoint        String   // e.g., "POST /api/v1/inventory-transactions"
  requestHash     String   // SHA-256 of request body
  responseBody    String   // cached response (JSON)
  responseStatus  Int      // cached HTTP status
  responseHeaders Json?    // cached headers
  expiresAt       DateTime // 24h after creation
  createdAt       DateTime @default(now())

  @@unique([tenantId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// LAW-08: Outbox Messages (reliable event publishing)
model OutboxMessage {
  id              String   @id @default(cuid())
  tenantId        String
  aggregateType   String
  aggregateId     String
  eventType       String
  eventVersion    String   @default("1.0")
  payload         Json
  actorId         String?
  occurredAt      DateTime @default(now())
  publishedAt     DateTime?
  attempts        Int      @default(0)
  nextRetryAt     DateTime?
  status          String   @default("pending") // pending|published|failed|dead_letter
  errorMessage    String?
  createdAt       DateTime @default(now())

  @@index([status, nextRetryAt])
  @@index([tenantId, occurredAt])
  @@map("outbox_messages")
}

// LAW-09: Processed Messages (consumer-side deduplication)
model ProcessedMessage {
  id              String   @id @default(cuid())
  tenantId        String
  messageId       String   // the event ID from Outbox
  consumerId      String   // identifies which consumer processed it
  payloadHash     String?
  processedAt     DateTime @default(now())

  @@unique([messageId, consumerId])
  @@index([tenantId, processedAt])
  @@map("processed_messages")
}

// LAW-10: Stock Balance Snapshots (ledger scalability)
model StockBalanceSnapshot {
  id                  String   @id @default(cuid())
  tenantId            String
  stockItemId         String
  onHandQuantity      Float
  reservedQuantity    Float
  lastTransactionId   String?
  snapshotAt          DateTime @default(now())
  snapshotType        String   // nightly|threshold|manual

  @@index([stockItemId, snapshotAt])
  @@map("stock_balance_snapshots")
}

// ============================================================
// SYSTEM TABLES
// ============================================================

model Tenant {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  defaultLocale String   @default("fa-IR")
  defaultTz     String   @default("Asia/Tehran")
  isActive      Boolean  @default(true)
  metadata      Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  users         User[]
  parties       Party[]
  branches      Branch[]
  productCategories ProductCategory[]
  productBrands     ProductBrand[]
  productModels     ProductModel[]
  products          Product[]
  productInstances  ProductInstance[]
}

// ============================================================
// IDENTITY CONTEXT (Sprint 1)
// ============================================================

model User {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  username        String
  displayName     String
  email           String?
  phone           String?
  userType        String   @default("staff") // customer|representative|technician|service_center|staff
  status          String   @default("active") // active|suspended|locked|deleted
  locale          String   @default("fa-IR")
  isActive        Boolean  @default(true)
  lockedUntil     DateTime?
  lastLoginAt     DateTime?
  metadata        Json
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@unique([tenantId, username])
  @@index([tenantId, status])
  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  tenantId    String
  key         String
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@unique([tenantId, key])
  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  module      String
  action      String
  description String?
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("permissions")
}

model Session {
  id              String   @id @default(cuid())
  userId          String
  tenantId        String
  status          String   @default("active") // active|expired|revoked
  ipAddress       String
  userAgent       String?
  deviceFingerprint String?
  issuedAt        DateTime @default(now())
  lastActivityAt  DateTime @default(now())
  expiresAt       DateTime
  absoluteExpiresAt DateTime
  revokedAt       DateTime?
  revokedReason   String?
  metadata        Json

  @@index([userId, status])
  @@map("sessions")
}

// ============================================================
// ORGANIZATION CONTEXT (Sprint 1)
// ============================================================

model Branch {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  name          String
  code          String
  parentId      String?
  address       Json?
  contactPhone  String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  @@unique([tenantId, code])
  @@map("branches")
}

// ============================================================
// PARTY CONTEXT (Sprint 1)
// ============================================================

model Party {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  businessCode    String   // LAW-02: PRT-1403-00001
  partyType       String   // person|organization
  displayName     String
  status          String   @default("active") // active|inactive|suspended|blacklisted
  taxId           String?
  registrationNo  String?
  metadata        Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@unique([tenantId, businessCode])
  @@index([tenantId, partyType])
  @@map("parties")
}

// ============================================================
// PRODUCT CONTEXT (Sprint 2.1) — NEW
// ============================================================

model ProductCategory {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  name          String
  code          String
  parentId      String?
  parent        ProductCategory? @relation("CategoryTree", fields: [parentId], references: [id])
  children      ProductCategory[] @relation("CategoryTree")
  level         Int      @default(0)
  path          String?
  isActive      Boolean  @default(true)
  description   String?
  attributes    Json // expected attributes
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  models        ProductModel[]

  @@unique([tenantId, code])
  @@index([parentId])
  @@map("product_categories")
}

model ProductBrand {
  id                  String   @id @default(cuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id])
  name                String
  nameEn              String?
  code                String
  manufacturerPartyId String?
  logoFileId          String?
  description         String?
  isActive            Boolean  @default(true)
  metadata            Json
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  deletedAt           DateTime?

  models              ProductModel[]

  @@unique([tenantId, code])
  @@map("product_brands")
}

model ProductModel {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  brandId         String
  brand           ProductBrand @relation(fields: [brandId], references: [id])
  categoryId      String
  category        ProductCategory @relation(fields: [categoryId], references: [id])
  name            String
  modelCode       String
  description     String?
  warrantyMonths  Int      @default(12)
  isSerialized    Boolean  @default(true)
  attributes      Json // model-level spec
  status          String   @default("active") // draft|active|discontinued|recall
  imageFileId     String?
  metadata        Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  products        Product[]

  @@unique([tenantId, modelCode])
  @@map("product_models")
}

model Product {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  modelId         String
  model           ProductModel @relation(fields: [modelId], references: [id])
  sku             String
  name            String
  productType     String   @default("serialized") // serialized|batch|bulk
  barcodeValue    String?
  unitOfMeasure   String   @default("piece")
  weightGrams     Int?
  dimensions      Json?
  description     String?
  status          String   @default("active") // draft|active|discontinued|recall
  attributes      Json
  metadata        Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  instances       ProductInstance[]

  @@unique([tenantId, sku])
  @@map("products")
}

model ProductInstance {
  id                  String   @id @default(cuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id])
  productId           String
  product             Product  @relation(fields: [productId], references: [id])
  serialNumber        String
  qrCode              String?
  status              String   @default("in_stock") // in_stock|reserved|sold|in_service|returned|scrapped|lost
  condition           String   @default("new") // new|refurbished|used|damaged
  manufactureDate     DateTime?
  importDate          DateTime?
  warrantyStart       DateTime?
  warrantyEnd         DateTime?
  currentWarehouseId  String?
  currentLocationId   String?
  currentOwnerPartyId String?
  supplierPartyId     String?
  importBatch         String?
  attributes          Json // IMEI, MAC, etc.
  metadata            Json
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  deletedAt           DateTime?

  @@unique([tenantId, serialNumber])
  @@map("product_instances")
}

// ============================================================
// BUSINESS CODE SEQUENCES (LAW-02) — Tenant Scoped + Unique Constraint
// ============================================================

model BusinessCodeSequence {
  id              String   @id @default(cuid())
  tenantId        String
  module          String   // e.g. "party", "sales_order", "product_category"
  prefix          String   // e.g. "PRT", "SO", "CAT"
  fiscalYear      Int      // Persian (Jalali) year
  lastValue       Int      @default(0)
  lastGeneratedAt DateTime?
  updatedAt       DateTime @updatedAt

  // CRITICAL: Unique constraint ensures concurrent requests can't duplicate
  @@unique([tenantId, module, prefix, fiscalYear])
  @@index([tenantId, module])
  @@map("business_code_sequences")
}

// ============================================================
// INVENTORY CONTEXT (Sprint 2.2A) — Warehouse, Zone, Location, Bin
// ============================================================

model Warehouse {
  id              String   @id @default(cuid())
  tenantId        String
  code            String   // Business code: WH-1403-00001
  name            String
  warehouseType   String   @default("main") // main|branch|service_center|transit|return
  branchId        String?
  serviceCenterId String?
  partyId         String?
  address         Json?
  isActive        Boolean  @default(true)
  isDefault       Boolean  @default(false)
  capacityCubic   Float?
  metadata        Json?
  version         Int      @default(1) // LAW-07: Optimistic Locking
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  zones           WarehouseZone[]
  locations       Location[]
  stockItems      StockItem[]

  @@unique([tenantId, code])
  @@index([tenantId, warehouseType])
  @@map("warehouses")
}

model WarehouseZone {
  id           String   @id @default(cuid())
  tenantId     String
  warehouseId  String
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id])
  code         String
  name         String
  zoneType     String?   // receiving|storage|shipping|returns|quarantine
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  locations    Location[]

  @@unique([warehouseId, code])
  @@map("warehouse_zones")
}

model Location {
  id           String   @id @default(cuid())
  tenantId     String
  warehouseId  String
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id])
  zoneId       String?
  zone         WarehouseZone? @relation(fields: [zoneId], references: [id])
  parentId     String?
  parent       Location?  @relation("LocationTree", fields: [parentId], references: [id])
  children     Location[] @relation("LocationTree")
  locationType String    // zone|aisle|rack|bin|shelf
  code         String
  name         String?
  fullPath     String
  level        Int       @default(0)
  isActive     Boolean   @default(true)
  isPickable   Boolean   @default(true)
  capacity     Json?
  metadata     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  bins         Bin[]
  stockItems   StockItem[]

  @@unique([warehouseId, code])
  @@index([parentId])
  @@map("locations")
}

model Bin {
  id            String   @id @default(cuid())
  tenantId      String
  locationId    String   @unique
  location      Location @relation(fields: [locationId], references: [id])
  warehouseId   String
  barcode       String?
  capacityUnits Int?
  currentUnits  Int      @default(0)
  isMixed       Boolean  @default(false) // allow multiple SKUs in same bin
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([warehouseId])
  @@map("bins")
}

// ============================================================
// INVENTORY CONTEXT (Sprint 2.2B) — Ledger Pattern + LAW-05
// ============================================================
// CRITICAL: StockItem has NO on_hand_quantity column.
// All quantities are derived from InventoryTransaction ledger.
// ============================================================

model StockItem {
  id                  String   @id @default(cuid())
  tenantId            String
  warehouseId         String
  warehouse           Warehouse @relation(fields: [warehouseId], references: [id])
  locationId          String?
  location            Location? @relation(fields: [locationId], references: [id])
  binId               String?
  productId           String   // FK to Product (loose, cross-context — LAW-04)
  productInstanceId   String?  // for serialized products (1:1 with instance)
  batchNumber         String?
  // ❌ NO on_hand_quantity column — LAW-05: derived from InventoryTransaction
  reservedQuantity    Float    @default(0)
  // availableQuantity is NOT stored — computed on read from ledger
  status              String   @default("available") // available|damaged|quarantine|expired
  receivedDate        DateTime?
  expiryDate          DateTime?
  lastTransactionAt   DateTime?
  metadata            Json?
  version             Int      @default(1) // LAW-07: Optimistic Locking
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  deletedAt           DateTime?

  transactions        InventoryTransaction[]
  reservations        StockReservation[]
  balance             StockBalance?

  @@unique([tenantId, warehouseId, productId, productInstanceId, batchNumber])
  @@index([tenantId, productId, warehouseId])
  @@index([productInstanceId])
  @@map("stock_items")
}

model InventoryTransaction {
  id                  String   @id @default(cuid())
  tenantId            String
  transactionNumber   String   // business code: IT-1403-00001
  transactionType     String   // IN|OUT|TRANSFER|ADJUSTMENT|RESERVATION|RELEASE|COUNT
  stockItemId         String
  stockItem           StockItem @relation(fields: [stockItemId], references: [id])
  productId           String
  productInstanceId   String?
  fromWarehouseId     String?
  fromLocationId      String?
  toWarehouseId       String?
  toLocationId        String?
  batchNumber         String?
  quantity            Float    // positive for IN, negative for OUT
  unitCost            Float?
  // ❌ NO totalCost stored as generated — pricing method (FIFO/LIFO/AVG) varies
  reason              String?
  referenceType       String?  // purchase_order|sales_order|transfer|count|adjustment
  referenceId         String?
  performedBy         String?
  occurredAt          DateTime @default(now())
  metadata            Json?
  createdAt           DateTime @default(now())

  @@unique([tenantId, transactionNumber])
  @@index([tenantId, occurredAt])
  @@index([stockItemId, occurredAt])
  @@index([productId, occurredAt])
  @@index([referenceType, referenceId])
  @@map("inventory_transactions")
}

model StockBalance {
  // Snapshot — explicitly marked as DERIVED (LAW-05)
  id                  String   @id @default(cuid())
  tenantId            String
  stockItemId         String   @unique
  stockItem           StockItem @relation(fields: [stockItemId], references: [id])
  onHandQuantity      Float    @default(0) // DERIVED from ledger
  reservedQuantity    Float    @default(0)
  availableQuantity   Float    @default(0) // DERIVED: on_hand - reserved
  lastTransactionId   String?
  snapshotAt          DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("stock_balances")
}

model StockReservation {
  id                  String   @id @default(cuid())
  tenantId            String
  reservationNumber   String   // business code: RES-1403-00001
  stockItemId         String
  stockItem           StockItem @relation(fields: [stockItemId], references: [id])
  productId           String
  productInstanceId   String?
  warehouseId         String
  reservedQuantity    Float
  reservationType     String   // sales_order|service_request|transfer|manual
  referenceType       String?
  referenceId         String?
  reservedBy          String?
  reservedForPartyId  String?
  reservedAt          DateTime @default(now())
  expiresAt           DateTime
  releasedAt          DateTime?
  releasedBy          String?
  releaseReason       String?
  consumedAt          DateTime?
  status              String   @default("active") // active|released|consumed|expired
  metadata            Json?
  version             Int      @default(1) // LAW-07
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([tenantId, reservationNumber])
  @@index([stockItemId, status])
  @@index([referenceType, referenceId])
  @@index([status, expiresAt])
  @@map("stock_reservations")
}

// ============================================================
// SPRINT 2.2C — Stock Transfers (Multi-Warehouse, Zone, Bin)
// ============================================================

model StockTransfer {
  id                  String   @id @default(cuid())
  tenantId            String
  transferNumber      String   // business code: TR-1403-00001
  transferType        String   // warehouse|zone|bin
  fromWarehouseId     String
  toWarehouseId       String?
  fromLocationId      String?
  toLocationId        String?
  fromBinId           String?
  toBinId             String?
  status              String   @default("draft") // draft|in_transit|received|partial|cancelled
  transferDate        DateTime @default(now())
  expectedArrival     DateTime?
  actualArrival       DateTime?
  shippedBy           String?
  receivedBy          String?
  transporterPartyId  String?
  notes               String?
  metadata            Json?
  version             Int      @default(1) // LAW-07
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  deletedAt           DateTime?

  lines               StockTransferLine[]

  @@unique([tenantId, transferNumber])
  @@index([fromWarehouseId, status])
  @@index([toWarehouseId, status])
  @@map("stock_transfers")
}

model StockTransferLine {
  id                  String   @id @default(cuid())
  tenantId            String
  transferId          String
  transfer            StockTransfer @relation(fields: [transferId], references: [id])
  stockItemId         String
  productId           String
  productInstanceId   String?
  batchNumber         String?
  quantity            Float
  quantityReceived    Float    @default(0)
  unitCost            Float?
  fromLocationId      String?
  toLocationId        String?
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([transferId])
  @@map("stock_transfer_lines")
}

// ============================================================
// SPRINT 2.2D — Cycle Count (Full Aggregate: Count → Variance → Approval → Adjustment → Ledger)
// ============================================================
// LAW: No direct adjustments — all adjustments go through approval flow
// ============================================================

model CycleCount {
  id              String   @id @default(cuid())
  tenantId        String
  countNumber     String   // business code: SC-1403-00001
  warehouseId     String
  countType       String   // full|cycle|spot
  status          String   @default("draft") // draft|in_progress|completed|approved|adjusted|cancelled
  scheduledDate   DateTime @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  approvedAt      DateTime?
  approvedBy      String?
  adjustedAt      DateTime?
  countedBy       String?
  reconciledBy    String?
  notes           String?
  metadata        Json?
  version         Int      @default(1) // LAW-07
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  lines           CycleCountLine[]

  @@unique([tenantId, countNumber])
  @@index([warehouseId, status])
  @@map("cycle_counts")
}

model CycleCountLine {
  id                  String   @id @default(cuid())
  tenantId            String
  cycleCountId        String
  cycleCount          CycleCount @relation(fields: [cycleCountId], references: [id])
  stockItemId         String
  productId           String
  productInstanceId   String?
  batchNumber         String?
  warehouseId         String
  locationId          String?
  // System quantity (snapshot at time of count start — LAW-05: from ledger)
  systemQuantity      Float    @default(0)
  // Counted quantity (entered by person doing physical count)
  countedQuantity     Float?
  // Variance = counted - system (computed, not stored as truth)
  // recountQuantity   Float?
  isReconciled        Boolean  @default(false)
  varianceReason      String?
  notes               String?
  countedAt           DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([cycleCountId, stockItemId])
  @@index([cycleCountId])
  @@map("cycle_count_lines")
}

// ============================================================
// SPRINT 3.1 — SALES FOUNDATION
// ============================================================
// SalesOrder, SalesOrderLine, PriceList, PriceListLine, Quote, QuoteLine
// All 15 Architecture Laws enforced.
// ============================================================

model SalesOrder {
  id              String   @id @default(cuid())
  tenantId        String
  orderNumber     String   // business code: SO-1403-00001
  customerPartyId String   // FK to Party (loose, cross-context — LAW-04)
  salesRepPartyId String?
  branchId        String?
  orderDate       DateTime @default(now())
  expectedDelivery DateTime?
  actualDelivery  DateTime?
  status          String   @default("draft") // draft|pending_approval|approved|rejected|invoiced|shipped|partially_shipped|completed|cancelled
  paymentStatus   String   @default("unpaid") // unpaid|partial|paid

  // Financial fields
  subtotal        Float    @default(0)
  discountAmount  Float    @default(0)
  taxAmount       Float    @default(0)
  shippingAmount  Float    @default(0)
  totalAmount     Float    @default(0)
  currencyCode    String   @default("IRR")

  notes           String?
  metadata        Json?
  version         Int      @default(1) // LAW-07: Optimistic Lock
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  lines           SalesOrderLine[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId, customerPartyId, orderDate])
  @@index([tenantId, status])
  @@map("sales_orders")
}

model SalesOrderLine {
  id                  String   @id @default(cuid())
  tenantId            String
  salesOrderId        String
  salesOrder          SalesOrder @relation(fields: [salesOrderId], references: [id])
  lineNumber          Int
  productId           String   // FK to Product (loose — LAW-04)
  productInstanceId   String?  // for serialized products
  quantityOrdered     Float
  quantityReserved    Float    @default(0)
  quantityShipped     Float    @default(0)
  quantityReturned    Float    @default(0)
  unitPrice           Float
  discountPercent     Float    @default(0)
  discountAmount      Float    @default(0)
  taxPercent          Float    @default(0)
  taxAmount           Float    @default(0)
  lineTotal           Float
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([salesOrderId, lineNumber])
  @@index([productId])
  @@map("sales_order_lines")
}

model PriceList {
  id              String   @id @default(cuid())
  tenantId        String
  listCode        String   // business code: PL-1403-001
  name            String
  priceType       String   // retail|wholesale|dealer|special
  validFrom       DateTime @default(now())
  validTo         DateTime?
  isActive        Boolean  @default(true)
  currencyCode    String   @default("IRR")
  description     String?
  metadata        Json?
  version         Int      @default(1) // LAW-07
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  lines           PriceListLine[]

  @@unique([tenantId, listCode])
  @@map("price_lists")
}

model PriceListLine {
  id              String   @id @default(cuid())
  tenantId        String
  priceListId     String
  priceList       PriceList @relation(fields: [priceListId], references: [id])
  productId       String   // FK to Product (loose — LAW-04)
  unitPrice       Float
  minQuantity     Float    @default(1)
  discountPercent Float    @default(0)
  validFrom       DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([priceListId, productId, minQuantity])
  @@index([productId])
  @@map("price_list_lines")
}

model Quote {
  id              String   @id @default(cuid())
  tenantId        String
  quoteNumber     String   // business code: QUO-1403-00001
  customerPartyId String
  salesRepPartyId String?
  quoteDate       DateTime @default(now())
  validUntil      DateTime
  status          String   @default("draft") // draft|sent|accepted|rejected|expired|converted
  subtotal        Float    @default(0)
  discountAmount  Float    @default(0)
  taxAmount       Float    @default(0)
  totalAmount     Float    @default(0)
  currencyCode    String   @default("IRR")
  customerApprovedAt DateTime?
  convertedSalesOrderId String?
  notes           String?
  metadata        Json?
  version         Int      @default(1) // LAW-07
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  lines           QuoteLine[]

  @@unique([tenantId, quoteNumber])
  @@index([tenantId, customerPartyId])
  @@map("quotes")
}

model QuoteLine {
  id              String   @id @default(cuid())
  tenantId        String
  quoteId         String
  quote           Quote    @relation(fields: [quoteId], references: [id])
  lineNumber      Int
  productId       String
  productInstanceId String?
  quantity        Float
  unitPrice       Float
  discountPercent Float    @default(0)
  discountAmount  Float    @default(0)
  taxPercent      Float    @default(0)
  taxAmount       Float    @default(0)
  lineTotal       Float
  notes           String?
  createdAt       DateTime @default(now())

  @@unique([quoteId, lineNumber])
  @@map("quote_lines")
}

// ============================================================
// SPRINT 3.2 — FULFILLMENT (Shipment, Pick, Pack, Delivery, Tracking)
// ============================================================
// LAW-16: No Physical Movement Without Ledger Event
// LAW-17: Reservation Before Shipment
// LAW-18: Shipment Immutable After Shipping
// ============================================================

model Shipment {
  id              String   @id @default(cuid())
  tenantId        String
  shipmentNumber  String   // business code: SHP-1403-00001
  salesOrderId    String?  // FK to SalesOrder (same context)
  customerPartyId String   // FK to Party (loose, cross-context — LAW-04)
  fromWarehouseId String
  toPartyId       String   // customer
  status          String   @default("draft") // draft|picking|packing|shipped|delivered|returned|cancelled
  shipmentDate    DateTime @default(now())
  expectedArrival DateTime?
  actualArrival   DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  shippingMethod  String?  // in_house|courier|post
  transporterPartyId String?
  trackingNumber  String?
  shippingCost    Float    @default(0)
  currencyCode    String   @default("IRR")
  notes           String?
  metadata        Json?
  version         Int      @default(1) // LAW-07
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  lines           ShipmentLine[]
  pickList        PickList?

  @@unique([tenantId, shipmentNumber])
  @@index([salesOrderId])
  @@index([tenantId, status])
  @@map("shipments")
}

model ShipmentLine {
  id                  String   @id @default(cuid())
  tenantId            String
  shipmentId          String
  shipment            Shipment @relation(fields: [shipmentId], references: [id])
  salesOrderLineId    String?
  lineNumber          Int
  productId           String
  productInstanceId   String?
  quantity            Float
  quantityPicked      Float    @default(0)
  quantityPacked      Float    @default(0)
  quantityShipped     Float    @default(0)
  quantityDelivered   Float    @default(0)
  quantityReturned    Float    @default(0)
  fromLocationId      String?
  toLocationId        String?
  batchNumber         String?
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([shipmentId, lineNumber])
  @@index([productId])
  @@map("shipment_lines")
}

model PickList {
  id              String   @id @default(cuid())
  tenantId        String
  pickListNumber  String   // business code: PL-1403-00001
  shipmentId      String   @unique
  shipment        Shipment @relation(fields: [shipmentId], references: [id])
  warehouseId     String
  status          String   @default("pending") // pending|in_progress|completed|cancelled
  assignedTo      String?
  startedAt       DateTime?
  completedAt     DateTime?
  notes           String?
  version         Int      @default(1) // LAW-07
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lines           PickListLine[]

  @@unique([tenantId, pickListNumber])
  @@map("pick_lists")
}

model PickListLine {
  id              String   @id @default(cuid())
  tenantId        String
  pickListId      String
  pickList        PickList @relation(fields: [pickListId], references: [id])
  shipmentLineId  String
  productId       String
  productInstanceId String?
  locationId      String?
  quantityToPick  Float
  quantityPicked  Float    @default(0)
  isPicked        Boolean  @default(false)
  pickedAt        DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([pickListId, shipmentLineId])
  @@map("pick_list_lines")
}

// ============================================================
// SPRINT 3.3 — BILLING (Invoice, Payment, Credit Note, Settlement)
// ============================================================
// LAW-19: Only Financial Context Creates Accounting Entries
// LAW-20: Every Payment Must Be Allocated
// LAW-21: Invoices Become Immutable After Issue
// ============================================================

model Invoice {
  id              String   @id @default(cuid())
  tenantId        String
  invoiceNumber   String   // business code: INV-1403-00001
  salesOrderId    String?  // FK to SalesOrder (same context)
  customerPartyId String   // FK to Party (loose — LAW-04)
  invoiceDate     DateTime @default(now())
  dueDate         DateTime?
  status          String   @default("draft") // draft|issued|partially_paid|paid|cancelled|reversed
  subtotal        Float    @default(0)
  discountAmount  Float    @default(0)
  taxAmount       Float    @default(0)
  shippingAmount  Float    @default(0)
  totalAmount     Float    @default(0)
  paidAmount      Float    @default(0)
  // balanceDue = totalAmount - paidAmount (computed on read — LAW-05)
  currencyCode    String   @default("IRR")
  taxInvoiceNumber String?  // official tax invoice number
  notes           String?
  metadata        Json?
  version         Int      @default(1) // LAW-07
  issuedAt        DateTime?
  cancelledAt     DateTime?
  reversedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  lines           InvoiceLine[]
  allocations     PaymentAllocation[]

  @@unique([tenantId, invoiceNumber])
  @@index([salesOrderId])
  @@index([tenantId, customerPartyId, invoiceDate])
  @@index([tenantId, status])
  @@map("invoices")
}

model InvoiceLine {
  id              String   @id @default(cuid())
  tenantId        String
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id])
  salesOrderLineId String?
  lineNumber      Int
  productId       String
  productInstanceId String?
  quantity        Float
  unitPrice       Float
  discountAmount  Float    @default(0)
  taxAmount       Float    @default(0)
  lineTotal       Float
  notes           String?
  createdAt       DateTime @default(now())

  @@unique([invoiceId, lineNumber])
  @@map("invoice_lines")
}

model Payment {
  id              String   @id @default(cuid())
  tenantId        String
  paymentNumber   String   // business code: PAY-1403-00001
  customerPartyId String   // FK to Party (loose — LAW-04)
  paymentDate     DateTime @default(now())
  amount          Float
  currencyCode    String   @default("IRR")
  paymentMethod   String   // cash|bank_transfer|check|credit_card|pos|online|wallet
  status          String   @default("pending") // pending|partially_allocated|completed|cancelled|failed
  referenceNumber String?  // bank reference / transaction ID
  bankAccount     String?
  depositedAt     DateTime?
  notes           String?
  metadata        Json?
  version         Int      @default(1) // LAW-07
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  allocations     PaymentAllocation[]

  @@unique([tenantId, paymentNumber])
  @@index([tenantId, customerPartyId, paymentDate])
  @@index([tenantId, status])
  @@map("payments")
}

model PaymentAllocation {
  id              String   @id @default(cuid())
  tenantId        String
  paymentId       String
  payment         Payment  @relation(fields: [paymentId], references: [id])
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id])
  allocatedAmount Float
  allocatedAt     DateTime @default(now())
  allocatedBy     String?
  notes           String?
  createdAt       DateTime @default(now())

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
  @@map("payment_allocations")
}

model CreditNote {
  id              String   @id @default(cuid())
  tenantId        String
  creditNoteNumber String  // business code: CN-1403-00001
  invoiceId       String   // the invoice being credited
  customerPartyId String
  creditNoteDate  DateTime @default(now())
  status          String   @default("draft") // draft|issued|applied|cancelled
  subtotal        Float    @default(0)
  taxAmount       Float    @default(0)
  totalAmount     Float    @default(0)
  currencyCode    String   @default("IRR")
  reason          String?
  notes           String?
  metadata        Json?
  version         Int      @default(1) // LAW-07
  issuedAt        DateTime?
  appliedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  lines           CreditNoteLine[]

  @@unique([tenantId, creditNoteNumber])
  @@index([invoiceId])
  @@map("credit_notes")
}

model CreditNoteLine {
  id              String   @id @default(cuid())
  tenantId        String
  creditNoteId    String
  creditNote      CreditNote @relation(fields: [creditNoteId], references: [id])
  invoiceLineId   String?
  lineNumber      Int
  productId       String?
  description     String
  quantity        Float    @default(1)
  unitPrice       Float    @default(0)
  taxAmount       Float    @default(0)
  lineTotal       Float
  notes           String?
  createdAt       DateTime @default(now())

  @@unique([creditNoteId, lineNumber])
  @@map("credit_note_lines")
}

// ============================================================
// SPRINT 3.4 — RETURNS & REFUNDS
// ============================================================
// LAW-22: No Return Receipt Without Physical Inspection
// LAW-23: Refund Requires Approved Return
// LAW-24: Replacement Is Return + New Fulfillment
// ============================================================

model ReturnOrder {
  id                  String   @id @default(cuid())
  tenantId            String
  returnNumber        String   // business code: RET-1403-00001
  salesOrderId        String?  // original sales order
  invoiceId           String?  // original invoice
  customerPartyId     String
  returnType          String   @default("refund") // refund|replacement|return_only
  status              String   @default("draft") // draft|submitted|approved|received|closed|cancelled
  returnDate          DateTime @default(now())
  approvedAt          DateTime?
  approvedBy          String?
  receivedAt          DateTime?
  receivedBy          String?
  closedAt            DateTime?
  refundAmount        Float    @default(0)
  currencyCode        String   @default("IRR")
  reason              String?
  notes               String?
  metadata            Json?
  version             Int      @default(1) // LAW-07
  // LAW-24: Replacement links
  replacementSalesOrderId String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  deletedAt           DateTime?

  lines               ReturnOrderLine[]
  refunds             Refund[]

  @@unique([tenantId, returnNumber])
  @@index([salesOrderId])
  @@index([tenantId, customerPartyId])
  @@index([tenantId, status])
  @@map("return_orders")
}

model ReturnOrderLine {
  id                  String   @id @default(cuid())
  tenantId            String
  returnOrderId       String
  returnOrder         ReturnOrder @relation(fields: [returnOrderId], references: [id])
  lineNumber          Int
  productId           String
  productInstanceId   String?
  quantityReturned    Float
  unitPrice           Float
  lineTotal           Float
  returnReason        String?
  // LAW-22: Physical Inspection fields
  inspectedCondition  String?  // new|used|damaged|defective
  inspectionNotes     String?
  inspectedBy         String?
  inspectedAt         DateTime?
  isInspected         Boolean  @default(false)
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([returnOrderId, lineNumber])
  @@map("return_order_lines")
}

model Refund {
  id              String   @id @default(cuid())
  tenantId        String
  refundNumber    String   // business code: RFD-1403-00001
  returnOrderId   String   // LAW-23: requires approved return
  returnOrder     ReturnOrder @relation(fields: [returnOrderId], references: [id])
  customerPartyId String
  refundDate      DateTime @default(now())
  amount          Float
  currencyCode    String   @default("IRR")
  refundMethod    String   // cash|bank_transfer|check|credit_card|pos|online|wallet
  status          String   @default("pending") // pending|approved|completed|cancelled
  referenceNumber String?
  approvedAt      DateTime?
  approvedBy      String?
  completedAt     DateTime?
  notes           String?
  metadata        Json?
  version         Int      @default(1) // LAW-07
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@unique([tenantId, refundNumber])
  @@index([returnOrderId])
  @@index([tenantId, customerPartyId])
  @@map("refunds")
}

// ============================================================
// SPRINT 3.5 — INTEGRATION (Saga, Inbox, Event Catalog)
// ============================================================
// LAW-25: No Cross-Context Synchronous Commands
// LAW-26: Every Domain Event Must Be Processed Exactly Once
// LAW-27: Every Long-Running Business Process Must Be a Saga
// ============================================================

model SagaDefinition {
  id              String   @id @default(cuid())
  tenantId        String
  key             String   // e.g., 'sales_order_fulfillment'
  name            String
  description     String?
  steps           Json     // [{ step: 1, name: 'reserve_inventory', event: 'sales_order.approved', compensation: 'release_reservation' }]
  isActive        Boolean  @default(true)
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, key])
  @@map("saga_definitions")
}

model SagaInstance {
  id              String   @id @default(cuid())
  tenantId        String
  sagaDefinitionKey String
  correlationId   String   // links to the business entity (e.g., sales order ID)
  status          String   @default("pending") // pending|running|completed|failed|compensating|compensated
  currentStep     Int      @default(0)
  totalSteps      Int      @default(0)
  payload         Json     // saga context data
  errorMessage     String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId, status])
  @@index([correlationId])
  @@map("saga_instances")
}

// ============================================================
// SPRINT 4 — WARRANTY CONTEXT
// ============================================================
// LAW-28: Warranty Activation Only From Shipment Delivered Event
// LAW-29: Every Warranty Claim Must Pass Inspection Before Approval
// LAW-30: Device Timeline Is Reconstructed From Immutable Domain Events
// ============================================================

model WarrantyPolicy {
  id              String   @id @default(cuid())
  tenantId        String
  productModelId  String?  // FK to ProductModel (loose — LAW-04)
  policyName      String
  warrantyType    String   @default("standard") // standard|extended|commercial|lifetime
  warrantyMonths  Int      @default(12)
  graceDays       Int      @default(0)
  isRenewable     Boolean  @default(true)
  coverageTerms   Json     // {parts: [...], labor: bool, ...}
  exclusions      Json     @default("[]")
  validFrom       DateTime @default(now())
  validTo         DateTime?
  isActive        Boolean  @default(true)
  metadata        Json?
  version         Int      @default(1) // LAW-07
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  cards           WarrantyCard[]

  @@unique([tenantId, productModelId, policyName])
  @@map("warranty_policies")
}

model WarrantyCard {
  id                  String   @id @default(cuid())
  tenantId            String
  warrantyNumber      String   // business code: WAR-1403-00001
  productInstanceId   String   // FK to ProductInstance (loose — LAW-04)
  customerPartyId     String   // FK to Party (loose — LAW-04)
  warrantyPolicyId    String
  warrantyPolicy      WarrantyPolicy @relation(fields: [warrantyPolicyId], references: [id])
  salesOrderId        String?
  shipmentId          String?
  activationDate      DateTime?
  startDate           DateTime?
  endDate             DateTime?
  graceEndDate        DateTime?
  status              String   @default("pending") // pending|active|expired|voided|transferred
  extendedMonths      Int      @default(0)
  notes               String?
  metadata            Json?
  version             Int      @default(1) // LAW-07
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  deletedAt           DateTime?

  claims              WarrantyClaim[]
  extensions          WarrantyExtension[]
  transfers           WarrantyTransfer[]

  @@unique([tenantId, warrantyNumber])
  @@unique([tenantId, productInstanceId])
  @@index([tenantId, customerPartyId])
  @@index([tenantId, status])
  @@map("warranty_cards")
}

model WarrantyClaim {
  id                  String   @id @default(cuid())
  tenantId            String
  claimNumber         String   // business code: WCL-1403-00001
  warrantyCardId      String
  warrantyCard        WarrantyCard @relation(fields: [warrantyCardId], references: [id])
  productInstanceId   String
  customerPartyId     String
  claimType           String   @default("defect") // defect|damage|malfunction|doa|other
  claimDate           DateTime @default(now())
  description         String
  defectDescription   String?
  status              String   @default("draft") // draft|submitted|inspection|approved|rejected|service_order|closed
  // LAW-29: Inspection fields
  defectType          String?  // mechanical|electrical|cosmetic|software|other
  defectSeverity      String?  // minor|moderate|major|critical
  isCovered           Boolean?
  inspectionNotes     String?
  inspectedBy         String?
  inspectedAt         DateTime?
  isInspected         Boolean  @default(false)
  // Approval
  approvedAt          DateTime?
  approvedBy          String?
  approvalNotes       String?
  rejectedAt          DateTime?
  rejectedBy          String?
  rejectionReason     String?
  // Service link
  serviceOrderId      String?
  // Resolution
  resolvedAt          DateTime?
  resolutionNotes     String?
  estimatedCost       Float?
  actualCost          Float?
  currencyCode        String   @default("IRR")
  metadata            Json?
  version             Int      @default(1) // LAW-07
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  deletedAt           DateTime?

  @@unique([tenantId, claimNumber])
  @@index([warrantyCardId])
  @@index([tenantId, customerPartyId, claimDate])
  @@index([tenantId, status])
  @@map("warranty_claims")
}

model WarrantyExtension {
  id              String   @id @default(cuid())
  tenantId        String
  extensionNumber String   // business code: WEX-1403-00001
  warrantyCardId  String
  warrantyCard    WarrantyCard @relation(fields: [warrantyCardId], references: [id])
  extensionType   String   // free|paid|promotional
  extensionMonths Int
  newEndDate      DateTime
  amountPaid      Float    @default(0)
  currencyCode    String   @default("IRR")
  paymentId       String?
  activationDate  DateTime @default(now())
  notes           String?
  metadata        Json?
  version         Int      @default(1) // LAW-07
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@unique([tenantId, extensionNumber])
  @@index([warrantyCardId])
  @@map("warranty_extensions")
}

model WarrantyTransfer {
  id              String   @id @default(cuid())
  tenantId        String
  transferNumber  String   // business code: WTR-1403-00001
  warrantyCardId  String
  warrantyCard    WarrantyCard @relation(fields: [warrantyCardId], references: [id])
  productInstanceId String
  fromPartyId     String
  toPartyId       String
  transferDate    DateTime @default(now())
  reason          String?
  transferFee     Float    @default(0)
  currencyCode    String   @default("IRR")
  approvalStatus  String   @default("pending") // pending|approved|rejected
  approvedBy      String?
  approvedAt      DateTime?
  notes           String?
  metadata        Json?
  version         Int      @default(1) // LAW-07
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, transferNumber])
  @@index([warrantyCardId])
  @@map("warranty_transfers")
}

// ============================================================
// SPRINT 5 — SERVICE CONTEXT
// ============================================================
// LAW-31: No Part Consumption Without Inventory Ledger Event
// LAW-32: Every Repair Must Pass Quality Control Before Delivery
// LAW-33: Warranty Approval Creates Service Request Only Through Events
// ============================================================

model ServiceRequest {
  id                  String   @id @default(cuid())
  tenantId            String
  requestNumber       String   // business code: SR-1403-00001
  customerPartyId     String   // FK to Party (loose — LAW-04)
  productInstanceId   String?  // FK to ProductInstance (loose — LAW-04)
  warrantyCardId      String?
  warrantyClaimId     String?  // LAW-33: linked from warranty claim event
  serviceCenterId     String?
  serviceKind         String   @default("warranty") // warranty|out_of_warranty|paid|recall
  priority            String   @default("normal") // low|normal|high|urgent|critical
  status              String   @default("draft") // draft|submitted|validated|service_order|cancelled
  customerProblem     String
  customerDescription String?
  deviceInfo          Json?    // {brand, model, serial, ...}
  reportedDefect      String?
  estimatedCompletion DateTime?
  actualCompletion    DateTime?
  customerConsent     Boolean  @default(false)
  serviceOrderId      String?  // link to ServiceOrder once created
  notes               String?
  metadata            Json?
  version             Int      @default(1) // LAW-07
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  deletedAt           DateTime?

  @@unique([tenantId, requestNumber])
  @@index([tenantId, customerPartyId])
  @@index([tenantId, status])
  @@index([warrantyClaimId])
  @@map("service_requests")
}

model ServiceOrder {
  id                  String   @id @default(cuid())
  tenantId            String
  orderNumber         String   // business code: RO-1403-00001
  serviceRequestId    String?
  customerPartyId     String
  productInstanceId   String?
  warrantyCardId      String?
  warrantyClaimId     String?
  serviceCenterId     String?
  assignedTechnicianId String? // FK to Party (loose — technicians are parties)
  serviceKind         String   @default("warranty")
  status              String   @default("open") // open|diagnosis|waiting_parts|repair|qc|ready|delivered|closed|cancelled
  createdDate         DateTime @default(now())
  diagnosisDate       DateTime?
  repairStartDate     DateTime?
  repairCompleteDate  DateTime?
  qcDate              DateTime?
  readyDate           DateTime?
  deliveredDate       DateTime?
  closedDate          DateTime?
  laborCost           Float    @default(0)
  partsCost           Float    @default(0)
  otherCost           Float    @default(0)
  discountAmount      Float    @default(0)
  taxAmount           Float    @default(0)
  totalCost           Float    @default(0)
  paidAmount          Float    @default(0)
  currencyCode        String   @default("IRR")
  notes               String?
  metadata            Json?
  version             Int      @default(1) // LAW-07
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  deletedAt           DateTime?

  lines               ServiceOrderLine[]
  parts               ServiceOrderPart[]
  laborRecords        ServiceOrderLabor[]
  diagnoses           ServiceDiagnosis[]
  qcChecks            ServiceQualityCheck[]

  @@unique([tenantId, orderNumber])
  @@index([serviceRequestId])
  @@index([tenantId, customerPartyId])
  @@index([tenantId, status])
  @@index([assignedTechnicianId])
  @@map("service_orders")
}

model ServiceOrderLine {
  id              String   @id @default(cuid())
  tenantId        String
  serviceOrderId  String
  serviceOrder    ServiceOrder @relation(fields: [serviceOrderId], references: [id])
  lineNumber      Int
  taskDescription String
  taskType        String?  // diagnosis|repair|replacement|testing
  estimatedHours  Float?
  actualHours     Float?
  completedAt     DateTime?
  isCompleted     Boolean  @default(false)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([serviceOrderId, lineNumber])
  @@map("service_order_lines")
}

model ServiceDiagnosis {
  id              String   @id @default(cuid())
  tenantId        String
  serviceOrderId  String
  serviceOrder    ServiceOrder @relation(fields: [serviceOrderId], references: [id])
  technicianPartyId String
  diagnosisDate   DateTime @default(now())
  symptom         String
  rootCause       String?
  recommendedAction String?
  estimatedHours  Float?
  estimatedPartsCost Float?
  confidenceLevel String?  // low|medium|high
  notes           String?
  createdAt       DateTime @default(now())

  @@index([serviceOrderId])
  @@map("service_diagnoses")
}

model ServiceOrderPart {
  id                  String   @id @default(cuid())
  tenantId            String
  serviceOrderId      String
  serviceOrder        ServiceOrder @relation(fields: [serviceOrderId], references: [id])
  productId           String   // FK to Product (loose — LAW-04)
  productInstanceId   String?  // for serialized parts
  fromWarehouseId     String?
  fromLocationId      String?
  quantityUsed        Float    @default(0)
  unitCost            Float    @default(0)
  totalCost           Float    @default(0)
  isWarrantyCovered   Boolean  @default(false)
  isReturnedPart      Boolean  @default(false)
  returnedToWarehouseId String?
  usedAt              DateTime @default(now())
  notes               String?
  createdAt           DateTime @default(now())

  @@index([serviceOrderId])
  @@index([productId])
  @@map("service_order_parts")
}

model ServiceOrderLabor {
  id                  String   @id @default(cuid())
  tenantId            String
  serviceOrderId      String
  serviceOrder        ServiceOrder @relation(fields: [serviceOrderId], references: [id])
  technicianPartyId   String
  laborType           String   // diagnosis|repair|testing|other
  hours               Float
  hourlyRate          Float
  totalCost           Float
  isWarrantyCovered   Boolean  @default(false)
  startedAt           DateTime?
  endedAt             DateTime?
  notes               String?
  createdAt           DateTime @default(now())

  @@index([serviceOrderId])
  @@index([technicianPartyId])
  @@map("service_order_labor")
}

model ServiceQualityCheck {
  id              String   @id @default(cuid())
  tenantId        String
  qcNumber        String   // business code: QC-1403-00001
  serviceOrderId  String
  serviceOrder    ServiceOrder @relation(fields: [serviceOrderId], references: [id])
  inspectorPartyId String?
  inspectionDate  DateTime @default(now())
  result          String   // pass|fail|conditional
  checklist       Json     // {items: [{name, passed, notes}]}
  defectsFound    String?
  reworkRequired  Boolean  @default(false)
  reworkNotes     String?
  approvedAt      DateTime?
  approvedBy      String?
  notes           String?
  version         Int      @default(1) // LAW-07
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, qcNumber])
  @@index([serviceOrderId])
  @@map("service_quality_checks")
}

model TechnicianAssignment {
  id                  String   @id @default(cuid())
  tenantId            String
  technicianPartyId   String
  serviceOrderId      String?
  serviceCenterId     String?
  assignmentType      String   @default("primary") // primary|secondary|supervisor
  status              String   @default("active") // active|completed|reassigned|cancelled
  assignedAt          DateTime @default(now())
  assignedBy          String?
  startTime           DateTime?
  endTime             DateTime?
  notes               String?
  metadata            Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([technicianPartyId, status])
  @@index([serviceOrderId])
  @@map("technician_assignments")
}

// ============================================================
// SPRINT 6 — FINANCIAL / ACCOUNTING CORE
// ============================================================
// LAW-34: Only Financial Context May Post To General Ledger
// LAW-35: Every Journal Entry Must Balance
// LAW-36: Closed Fiscal Period Is Immutable
// ============================================================

model ChartOfAccount {
  id              String   @id @default(cuid())
  tenantId        String
  accountCode     String   // e.g., '1000', '1100', '4000'
  accountName     String
  accountNameEn   String?
  accountType     String   // asset|liability|equity|revenue|expense
  parentAccountId String?
  parent          ChartOfAccount? @relation("AccountTree", fields: [parentAccountId], references: [id])
  children        ChartOfAccount[] @relation("AccountTree")
  level           Int      @default(0)
  isPostable      Boolean  @default(true) // leaf vs header
  isControlAccount Boolean @default(false) // AR, AP control accounts
  isActive        Boolean  @default(true)
  openingBalance  Float    @default(0)
  currencyCode    String   @default("IRR")
  description     String?
  metadata        Json?
  version         Int      @default(1) // LAW-07
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  journalLines    JournalEntryLine[]

  @@unique([tenantId, accountCode])
  @@index([parentAccountId])
  @@map("chart_of_accounts")
}

model FiscalYear {
  id          String   @id @default(cuid())
  tenantId    String
  yearCode    String   // e.g., '1403', '1404'
  name        String
  startDate   DateTime
  endDate     DateTime
  status      String   @default("open") // open|closed
  closedAt    DateTime?
  closedBy    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  periods     FiscalPeriod[]

  @@unique([tenantId, yearCode])
  @@map("fiscal_years")
}

model FiscalPeriod {
  id          String   @id @default(cuid())
  tenantId    String
  fiscalYearId String
  fiscalYear  FiscalYear @relation(fields: [fiscalYearId], references: [id])
  periodCode  String   // e.g., '1403-Q1', '1403-01'
  name        String
  periodType  String   // month|quarter|year
  startDate   DateTime
  endDate     DateTime
  status      String   @default("open") // open|temporarily_closed|closed
  closedAt    DateTime?
  closedBy    String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, periodCode])
  @@map("fiscal_periods")
}

model CostCenter {
  id              String   @id @default(cuid())
  tenantId        String
  code            String   // e.g., 'CC-001'
  name            String
  parentId        String?
  parent          CostCenter? @relation("CostCenterTree", fields: [parentId], references: [id])
  children        CostCenter[] @relation("CostCenterTree")
  level           Int      @default(0)
  isActive        Boolean  @default(true)
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@unique([tenantId, code])
  @@map("cost_centers")
}

model TaxCode {
  id              String   @id @default(cuid())
  tenantId        String
  code            String   // e.g., 'VAT09', 'EXEMPT'
  taxType         String   // vat|sales_tax|withholding|exempt
  name            String
  ratePercent     Float    // 9.00, 0.00
  inputAccountId  String?  // recoverable input tax account (for VAT)
  outputAccountId String?  // output tax payable account
  isRecoverable   Boolean  @default(false)
  isDefault       Boolean  @default(false)
  isActive        Boolean  @default(true)
  description     String?
  validFrom       DateTime @default(now())
  validTo         DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  rules           TaxRule[]      @relation("TaxCodeRules")
  calculations    TaxCalculation[] @relation("TaxCodeCalculations")

  @@unique([tenantId, code])
  @@map("tax_codes")
}

model JournalEntry {
  id              String   @id @default(cuid())
  tenantId        String
  entryNumber     String   // business code: JE-1403-00001
  entryDate       DateTime
  fiscalPeriodId  String?
  description     String
  sourceType      String?  // sales_invoice|payment|credit_note|refund|inventory_adjustment|service_charge|manual
  sourceId        String?  // ID of the source entity (event aggregateId)
  status          String   @default("draft") // draft|posted|reversed
  totalDebit      Float    @default(0)
  totalCredit     Float    @default(0)
  // isBalanced = (totalDebit === totalCredit) — validated at application level (LAW-35)
  reversedById    String?  // reference to reversal JE
  reversedAt      DateTime?
  reversalReason  String?
  postedAt        DateTime?
  postedBy        String?
  notes           String?
  metadata        Json?
  version         Int      @default(1) // LAW-07
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  lines           JournalEntryLine[]

  @@unique([tenantId, entryNumber])
  @@index([tenantId, entryDate])
  @@index([sourceType, sourceId])
  @@index([status])
  @@map("journal_entries")
}

model JournalEntryLine {
  id              String   @id @default(cuid())
  tenantId        String
  journalEntryId  String
  journalEntry    JournalEntry @relation(fields: [journalEntryId], references: [id])
  lineNumber      Int
  accountId       String
  account         ChartOfAccount @relation(fields: [accountId], references: [id])
  costCenterId    String?
  partyId         String?  // sub-ledger reference (customer/supplier)
  debitAmount     Float    @default(0)
  creditAmount    Float    @default(0)
  description     String?
  referenceType   String?
  referenceId     String?
  metadata        Json?
  createdAt       DateTime @default(now())

  @@unique([journalEntryId, lineNumber])
  @@index([accountId])
  @@index([costCenterId])
  @@map("journal_entry_lines")
}

// ============================================================
// SPRINT 6.3 — AR/AP SUB-LEDGER ENGINE
// ============================================================
// LAW-40: Subledger Must Reconcile With General Ledger
// LAW-41: Every Allocation Must Be Reversible
// LAW-42: Customer/Vendor Balance Is Derived (not stored)
// ============================================================

model ARTransaction {
  id              String   @id @default(cuid())
  tenantId        String
  customerPartyId String
  transactionType String   // invoice|payment|credit_note|refund|opening
  referenceType   String   // sales_invoice|payment|credit_note|refund
  referenceId     String
  entryDate       DateTime @default(now())
  amount          Float    // positive = debit (invoice), negative = credit (payment)
  openAmount      Float    @default(0) // remaining unallocated (derived but cached for query perf)
  status          String   @default("open") // open|partially_allocated|fully_allocated
  description     String?
  metadata        Json?
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  allocations     ARAllocation[] @relation("DebitAllocations")
  creditAllocations ARAllocation[] @relation("CreditAllocations")

  @@index([tenantId, customerPartyId, entryDate])
  @@index([status])
  @@index([referenceType, referenceId])
  @@map("ar_transactions")
}

model ARAllocation {
  id                String   @id @default(cuid())
  tenantId          String
  customerPartyId   String
  debitTransactionId  String  // ARTransaction (invoice/charge)
  debitTransaction    ARTransaction @relation("DebitAllocations", fields: [debitTransactionId], references: [id])
  creditTransactionId String  // ARTransaction (payment/credit)
  creditTransaction   ARTransaction @relation("CreditAllocations", fields: [creditTransactionId], references: [id])
  allocatedAmount   Float    // positive = allocate, negative = unallocate (reversal — LAW-41)
  allocationDate    DateTime @default(now())
  allocatedBy       String?
  reversalOfId      String?  // if this is a reversal, references original allocation (LAW-41)
  notes             String?
  createdAt         DateTime @default(now())

  @@index([debitTransactionId])
  @@index([creditTransactionId])
  @@map("ar_allocations")
}

model APTransaction {
  id              String   @id @default(cuid())
  tenantId        String
  vendorPartyId   String
  transactionType String   // vendor_bill|payment|credit|opening
  referenceType   String   // ap_invoice|payment|credit
  referenceId     String
  entryDate       DateTime @default(now())
  amount          Float    // positive = credit (bill owed), negative = debit (payment)
  openAmount      Float    @default(0)
  status          String   @default("open") // open|partially_allocated|fully_allocated
  description     String?
  metadata        Json?
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  allocations     APAllocation[] @relation("DebitAllocations")
  creditAllocations APAllocation[] @relation("CreditAllocations")

  @@index([tenantId, vendorPartyId, entryDate])
  @@index([status])
  @@index([referenceType, referenceId])
  @@map("ap_transactions")
}

model APAllocation {
  id                String   @id @default(cuid())
  tenantId          String
  vendorPartyId     String
  debitTransactionId  String  // APTransaction (payment)
  debitTransaction    APTransaction @relation("DebitAllocations", fields: [debitTransactionId], references: [id])
  creditTransactionId String  // APTransaction (vendor bill)
  creditTransaction   APTransaction @relation("CreditAllocations", fields: [creditTransactionId], references: [id])
  allocatedAmount   Float    // positive = allocate, negative = unallocate (LAW-41)
  allocationDate    DateTime @default(now())
  allocatedBy       String?
  reversalOfId      String?
  notes             String?
  createdAt         DateTime @default(now())

  @@index([debitTransactionId])
  @@index([creditTransactionId])
  @@map("ap_allocations")
}

// ============================================================
// SPRINT 6.4 — TAX ENGINE
// ============================================================
// LAW-43: Tax Is Always Derived From Tax Rules
// LAW-44: Every Tax Posting Must Produce Independent Journal Entries
// LAW-45: Tax Rules Are Versioned And Effective-Dated
// ============================================================

model TaxRule {
  id                String   @id @default(cuid())
  tenantId          String
  taxCodeId         String
  taxCode           TaxCode  @relation("TaxCodeRules", fields: [taxCodeId], references: [id])
  name              String
  productCategoryId String?  // FK to ProductCategory (loose — LAW-04)
  customerGroupId   String?  // optional: customer group scope
  regionId          String?  // optional: geographic region
  effectiveFrom     DateTime @default(now())
  effectiveTo       DateTime?  // null = currently active (LAW-45)
  priority          Int      @default(100) // higher = more specific, evaluated first
  formula           String   @default("rate * taxableAmount") // calculation formula
  rateOverride      Float?   // override the TaxCode.rate if set
  isReverseCharge   Boolean  @default(false)
  isActive          Boolean  @default(true)
  version           Int      @default(1) // LAW-45: versioned
  description       String?
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  calculations      TaxCalculation[]

  @@index([taxCodeId, effectiveFrom, effectiveTo])
  @@index([tenantId, isActive])
  @@map("tax_rules")
}

model TaxCalculation {
  id              String   @id @default(cuid())
  tenantId        String
  documentType    String   // sales_invoice|purchase_invoice|credit_note|payment
  documentId      String
  taxCodeId       String
  taxCode         TaxCode  @relation("TaxCodeCalculations", fields: [taxCodeId], references: [id])
  taxRuleId       String
  taxRule         TaxRule  @relation(fields: [taxRuleId], references: [id])
  taxableAmount   Float
  taxRate         Float    // snapshot of effective rate at calculation time
  taxAmount       Float
  currencyCode    String   @default("IRR")
  calculationDate DateTime @default(now())
  snapshot        Json     // full context snapshot (for audit — LAW-43)
  createdAt       DateTime @default(now())

  postings        TaxPosting[]

  @@index([documentType, documentId])
  @@index([taxCodeId])
  @@map("tax_calculations")
}

model TaxPosting {
  id                  String   @id @default(cuid())
  tenantId            String
  journalEntryId      String   // FK to JournalEntry (loose — within Financial)
  taxCalculationId    String
  taxCalculation      TaxCalculation @relation(fields: [taxCalculationId], references: [id])
  postedAt            DateTime @default(now())
  createdAt           DateTime @default(now())

  @@index([taxCalculationId])
  @@map("tax_postings")
}

// ============================================================
// SPRINT 7.1 — WORKFLOW ENGINE
// ============================================================
// LAW-49: Only Workflow Engine May Change Workflow State
// ============================================================

model WorkflowDefinition {
  id              String   @id @default(cuid())
  tenantId        String
  key             String   // e.g., 'sales_order_approval', 'warranty_claim'
  name            String
  entityType      String   // what entity this WF runs on (sales_order, warranty_claim, etc.)
  version         Int      @default(1)
  isActive        Boolean  @default(true)
  publishedAt     DateTime?
  description     String?
  states          Json     // [{ key, name, isInitial, isFinal, metadata }]
  transitions     Json     // [{ key, fromState, toState, triggerType, guardRuleSetId, requiredPermission, metadata }]
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  instances       WorkflowInstance[]

  @@unique([tenantId, key, version])
  @@index([tenantId, key, isActive])
  @@map("workflow_definitions")
}

model WorkflowInstance {
  id              String   @id @default(cuid())
  tenantId        String
  definitionId    String
  definition      WorkflowDefinition @relation(fields: [definitionId], references: [id])
  definitionKey   String
  definitionVersion Int
  entityType      String
  entityId        String
  currentStateKey String
  status          String   @default("running") // running|completed|cancelled
  startedBy       String?
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancelledBy     String?
  cancelReason    String?
  metadata        Json?
  version         Int      @default(1) // LAW-07: Optimistic Lock
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  history         WorkflowHistory[]

  @@index([entityType, entityId])
  @@index([tenantId, status])
  @@map("workflow_instances")
}

model WorkflowHistory {
  id              String   @id @default(cuid())
  tenantId        String
  instanceId      String
  instance        WorkflowInstance @relation(fields: [instanceId], references: [id])
  fromState       String?
  toState         String
  transitionKey   String?
  changedBy       String?
  changedAt       DateTime @default(now())
  reason          String?
  metadata        Json?

  @@index([instanceId, changedAt])
  @@map("workflow_history")
}
