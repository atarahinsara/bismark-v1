// ============================================================
// PHASE 3: Bank Reconciliation (T-3-05)
// ============================================================

model BankAccount {
  id              String   @id @default(cuid())
  tenantId        String
  accountName     String
  accountNumber   String   // masked (last 4 digits)
  bankName        String
  branchCode      String?
  iban            String?  // International Bank Account Number
  currencyCode    String   @default("IRR")
  chartOfAccountId String? // linked GL account
  openingBalance  Float    @default(0)
  currentBalance  Float    @default(0)
  lastReconciledAt DateTime?
  isActive        Boolean  @default(true)
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  transactions    BankTransaction[]
  reconciliations BankReconciliation[]

  @@unique([tenantId, accountNumber])
  @@index([tenantId, isActive])
  @@map("bank_accounts")
}

model BankTransaction {
  id              String   @id @default(cuid())
  tenantId        String
  bankAccountId   String
  bankAccount     BankAccount @relation(fields: [bankAccountId], references: [id])
  transactionDate DateTime
  amount          Float     // positive = credit (deposit), negative = debit (withdrawal)
  balanceAfter    Float?
  description     String
  referenceNumber String?   // bank reference
  checkNumber     String?
  counterpartyName String?
  counterpartyAccount String?
  status          String    @default("imported") // imported|matched|unmatched|ignored
  matchedPaymentId String?
  matchedInvoiceId String?
  matchedJeLineId  String?
  reconciliationId String?
  reconciliation   BankReconciliation? @relation("BankTransactionReconciliation", fields: [reconciliationId], references: [id])
  metadata        Json?
  createdAt       DateTime @default(now())

  @@index([tenantId, bankAccountId, transactionDate])
  @@index([tenantId, status])
  @@map("bank_transactions")
}

model BankReconciliation {
  id              String   @id @default(cuid())
  tenantId        String
  bankAccountId   String
  bankAccount     BankAccount @relation(fields: [bankAccountId], references: [id])
  reconciliationDate DateTime @default(now())
  periodStart     DateTime
  periodEnd       DateTime
  openingBalance  Float
  closingBalance  Float
  bankStatementBalance Float
  adjustedBalance Float
  difference      Float    @default(0)
  status          String   @default("in_progress") // in_progress|completed|cancelled
  completedAt     DateTime?
  completedBy     String?
  matchedCount    Int      @default(0)
  unmatchedCount  Int      @default(0)
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  transactions    BankTransaction[] @relation("BankTransactionReconciliation")

  @@index([tenantId, bankAccountId, status])
  @@map("bank_reconciliations")
}

// ============================================================
// PHASE 4: Technician Mobile + Offline Sync (T-4-01 to T-4-04)
// ============================================================

model Device {
  id              String   @id @default(cuid())
  tenantId        String
  userId          String   // technician user
  deviceName      String?
  deviceType      String   @default("android") // android|ios|pwa
  deviceModel     String?
  osVersion       String?
  appVersion      String?
  pushToken       String?  // FCM/APNs token
  deviceFingerprint String? // unique device identifier
  lastSeenAt      DateTime @default(now())
  isActive        Boolean  @default(true)
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  syncQueue       OfflineSyncQueue[]

  @@unique([tenantId, userId, deviceFingerprint])
  @@index([tenantId, userId, isActive])
  @@map("devices")
}

model OfflineSyncQueue {
  id              String   @id @default(cuid())
  tenantId        String
  deviceId        String
  device          Device   @relation(fields: [deviceId], references: [id])
  userId          String   // technician who created the operation
  operationId     String   // client-generated UUID for idempotency
  entityType      String   // job|diagnosis|part|photo|signature|checkin|checkout|complete
  entityId        String   // job ID or related entity ID
  operationType   String   // create|update|delete
  payload         Json     // operation data
  clientCreatedAt DateTime // timestamp from client when operation was created
  status          String   @default("pending") // pending|syncing|success|conflict|failed
  attempts        Int      @default(0)
  lastAttemptAt   DateTime?
  errorMessage    String?
  conflictData    Json?    // server-side data when conflict detected
  syncedAt        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, operationId]) // idempotency: same operationId = same operation
  @@index([tenantId, deviceId, status])
  @@index([tenantId, userId, status])
  @@map("offline_sync_queue")
}

model MobileJobSnapshot {
  id              String   @id @default(cuid())
  tenantId        String
  deviceId        String
  serviceOrderId  String
  snapshotData    Json     // full job data for offline access
  snapshotVersion Int      @default(1) // for optimistic locking
  syncedAt        DateTime @default(now())
  expiresAt       DateTime // snapshot expires after X days
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, deviceId, serviceOrderId])
  @@index([tenantId, deviceId])
  @@map("mobile_job_snapshots")
}

model TechnicianLocation {
  id              String   @id @default(cuid())
  tenantId        String
  technicianId    String   // Party ID
  serviceOrderId  String?
  latitude        Float
  longitude       Float
  accuracy        Float?   // meters
  speed           Float?   // m/s
  heading         Float?   // degrees
  recordedAt      DateTime
  createdAt       DateTime @default(now())

  @@index([tenantId, technicianId, recordedAt])
  @@index([tenantId, serviceOrderId, recordedAt])
  @@map("technician_locations")
}

// ============================================================
// GOLDEN SLICE — Phase 3 (Master Spec v1.0)
// ============================================================

// --- Queen Correction 1: TechnicianJob ---
// مستقل از ServiceOrder. یک ServiceOrder می‌تواند چند Job داشته باشد.

model TechnicianJob {
  id              String   @id @default(cuid())
  tenantId        String
  jobNumber       String   // business code: JOB-1403-00001
  serviceRequestId String? // link to ServiceRequest (loose FK)
  serviceOrderId   String? // link to ServiceOrder (loose FK)
  technicianId     String? // FK to Party (technician)
  customerId       String  // FK to Party (customer)
  productInstanceId String? // FK to ProductInstance (loose)
  status           String   @default("created") // created|assigned|accepted|in_progress|completed|cancelled|failed
  priority         String   @default("normal") // low|normal|high|urgent|critical
  scheduledStartTime DateTime?
  scheduledEndTime   DateTime?
  actualStartTime    DateTime?
  actualEndTime      DateTime?
  acceptedAt         DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  serviceReportId    String? // FK to ServiceReport (loose)
  notes              String?
  metadata           Json?
  version            Int      @default(1) // LAW-07
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([tenantId, jobNumber])
  @@index([tenantId, technicianId, status])
  @@index([tenantId, serviceRequestId])
  @@index([tenantId, serviceOrderId])
  @@index([tenantId, customerId, createdAt])
  @@map("technician_jobs")
}

// --- Queen Correction 2: Van Stock ---

model VanStock {
  id              String   @id @default(cuid())
  tenantId        String
  technicianId    String   // FK to Party (technician who owns the van)
  productId       String   // FK to Product (loose)
  quantity        Float    @default(0)
  reservedQuantity Float   @default(0)
  lastRestockedAt DateTime?
  metadata        Json?
  version         Int      @default(1) // LAW-07
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ledger          VanStockLedger[]

  @@unique([tenantId, technicianId, productId])
  @@index([tenantId, technicianId])
  @@map("van_stocks")
}

model VanStockLedger {
  id              String   @id @default(cuid())
  tenantId        String
  vanStockId      String
  vanStock        VanStock @relation(fields: [vanStockId], references: [id])
  technicianId    String
  productId       String
  transactionType String   // restock|consume|transfer_in|transfer_out|adjustment|return
  quantity        Float    // positive=in, negative=out
  balanceAfter    Float    // snapshot of quantity after this transaction
  referenceType   String?  // technician_job|van_transfer|van_restock|manual_adjustment
  referenceId     String?
  performedBy     String?
  performedAt     DateTime @default(now())
  notes           String?
  metadata        Json?
  createdAt       DateTime @default(now())

  @@index([tenantId, vanStockId, performedAt])
  @@index([tenantId, technicianId, productId, performedAt])
  @@map("van_stock_ledger")
}

model VanTransfer {
  id              String   @id @default(cuid())
  tenantId        String
  transferNumber  String   // business code: VTR-1403-00001
  fromWarehouseId String?  // source warehouse (null = direct from supplier)
  toTechnicianId  String   // destination technician
  productId       String
  quantity        Float
  status          String   @default("draft") // draft|shipped|received|cancelled
  shippedAt       DateTime?
  receivedAt      DateTime?
  shippedBy       String?
  receivedBy      String?
  notes           String?
  metadata        Json?
  version         Int      @default(1) // LAW-07
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, transferNumber])
  @@index([tenantId, toTechnicianId, status])
  @@index([tenantId, productId])
  @@map("van_transfers")
}

model VanRestockRequest {
  id              String   @id @default(cuid())
  tenantId        String
  requestNumber   String   // business code: VRR-1403-00001
  technicianId    String   // requesting technician
  productId       String
  quantityRequested Float
  quantityApproved  Float?
  status          String   @default("pending") // pending|approved|rejected|fulfilled|cancelled
  requestedAt     DateTime @default(now())
  approvedAt      DateTime?
  approvedBy      String?
  fulfilledAt     DateTime?
  fulfilledBy     String?
  rejectionReason String?
  notes           String?
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, requestNumber])
  @@index([tenantId, technicianId, status])
  @@index([tenantId, productId])
  @@map("van_restock_requests")
}

// --- ServiceReport ---

model ServiceReport {
  id              String   @id @default(cuid())
  tenantId        String
  reportNumber    String   // business code: RPT-1403-00001
  technicianJobId String   // FK to TechnicianJob (loose)
  serviceOrderId  String?  // FK to ServiceOrder (loose)
  technicianId    String   // FK to Party (technician)
  reportDate      DateTime @default(now())
  status          String   @default("draft") // draft|submitted|approved|rejected
  workSummary     String
  workPerformed   Json     // [{ step, description, duration_minutes }]
  partsUsed       Json     // [{ productId, quantity, vanStockLedgerId? }]
  laborHours      Float    @default(0)
  laborCost       Float    @default(0)
  partsCost       Float    @default(0)
  totalCost       Float    @default(0)
  photosBefore    Json?    // [{ fileId, url }]
  photosAfter     Json?    // [{ fileId, url }]
  customerSignature String? // base64 or fileId
  customerFeedback String?
  customerRating   Int?    // 1-5
  submittedAt     DateTime?
  approvedAt      DateTime?
  approvedBy      String?
  rejectionReason String?
  notes           String?
  metadata        Json?
  version         Int      @default(1) // LAW-07
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, reportNumber])
  @@index([tenantId, technicianJobId])
  @@index([tenantId, technicianId, reportDate])
  @@index([tenantId, status])
  @@map("service_reports")
}
// ============================================================
// AUTH EXTENSIONS — Password Reset, Email Verification
// ============================================================

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String
  token     String   @unique
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tenantId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String
  token     String   @unique
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

// ============================================================
// SYSTEM SETTINGS — Configurable from Admin Panel
// ============================================================

model SystemSetting {
  id        String   @id @default(cuid())
  tenantId  String?
  key       String
  value     String
  type      String   @default("string") // string|boolean|number|json
  category  String   @default("general") // general|security|email|captcha|notifications
  description String?
  isPublic  Boolean  @default(false) // visible to non-admin users?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([category])
  @@map("system_settings")
}

// ============================================================
// NOTIFICATIONS — Real DB-backed notification system


// ============================================================
// USER NOTIFICATIONS — Simple in-app notifications with read/unread
// ============================================================

model UserNotification {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String    @default("info") // info|success|warning|error|system
  category  String    @default("general") // general|auth|security|order|inventory|financial
  link      String?
  metadata  Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([tenantId, createdAt])
  @@map("user_notifications")
}

// ============================================================
// EMAIL LOGS — Track all outgoing emails
// ============================================================

model EmailLog {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String?
  to        String
  subject   String
  body      String?
  type      String   @default("general") // verification|reset_password|login_notification|test|general
  status    String   @default("pending") // pending|sent|failed
  errorMessage String?
  messageId String? // provider message ID
  ipAddress String?
  sentAt    DateTime?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("email_logs")
}
